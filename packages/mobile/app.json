{
  "expo": {
    "name": "CodeLink",
    "slug": "codelink",
    "version": "2.0.0",
    "scheme": "codelink",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CodeLink needs camera access to scan QR codes for pairing with VS Code."
        }
      ]
    ],
    "ios": { "bundleIdentifier": "io.codelink.app" },
    "android": {
      "package": "io.codelink.app",
      "adaptiveIcon": { "backgroundColor": "#0a0a0a" }
    }
  }
}