{
  "name": "codelink-extension",
  "displayName": "CodeLink",
  "version": "2.0.0",
  "publisher": "codelink",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codelink.startPairing",
        "title": "CodeLink: Pair Mobile Device"
      },
      {
        "command": "codelink.revokeSession",
        "title": "CodeLink: Revoke Mobile Session"
      },
      {
        "command": "codelink.showStatus",
        "title": "CodeLink: Show Connection Status"
      },
      {
        "command": "codelink.resetIdentity",
        "title": "CodeLink: Reset Identity"
      },
      {
        "command": "codelink.reRegister",
        "title": "CodeLink: Re-register Laptop (Reset Identity & Keys)"
      },
      {
        "command": "codelink.terminalMenu",
        "title": "CodeLink: Managed Terminal Status & Controls"
      },
      {
        "command": "codelink.terminal.pairDevice",
        "title": "CodeLink: Generate Terminal Pairing Code"
      },
      {
        "command": "codelink.terminal.reviewPending",
        "title": "CodeLink: Review Pending Terminal Pairings"
      }
    ],
    "configuration": {
      "title": "CodeLink",
      "properties": {
        "codelink.authServiceUrl": {
          "type": "string",
          "default": "http://localhost:8081",
          "description": "URL of the CodeLink Auth Service"
        },
        "codelink.relayServiceUrl": {
          "type": "string",
          "default": "ws://localhost:8082",
          "description": "WebSocket URL of the CodeLink Relay Service"
        },
        "codelink.terminal.companionPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the CodeLink Terminal Companion binary (codelink-terminal.js)"
        },
        "codelink.terminal.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to Node.js binary used to spawn the companion daemon"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@codelink/protocol": "^2.0.0",
    "diff-match-patch": "^1.0.5",
    "qrcode": "^1.5.4",
    "simple-git": "^3.25.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
