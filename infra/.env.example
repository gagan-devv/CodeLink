# ── Auth Service ────────────────────────────────────────────────
AUTH_PORT=8081
POSTGRES_URL=postgres://codelink:devpassword@postgres:5432/codelink
REDIS_URL=redis://redis:6379

# 32+ random bytes — generate with: openssl rand -hex 32
AUTH_HMAC_SECRET=

# RSA-2048 private key PEM — generate with instructions in README
AUTH_PRIVATE_KEY_PEM=

# Comma-separated list of allowed browser origins (no wildcards, exact scheme+host+port, no trailing slash)
# Dev examples: http://localhost:19006,http://localhost:5173
# In production, use real https origins only: https://app.codelink.io
AUTH_ALLOWED_ORIGINS=


# ── Relay Service ───────────────────────────────────────────────
RELAY_PORT=8082
REDIS_URL=redis://redis:6379

# RSA-2048 public key PEM — matching pair to AUTH_PRIVATE_KEY_PEM
AUTH_PUBLIC_KEY_PEM=

# Comma-separated list of allowed WebSocket browser origins (no wildcards, exact scheme+host+port, no trailing slash)
# Dev examples: http://localhost:19006,http://localhost:5173
# In production, use real https origins only: https://app.codelink.io
RELAY_ALLOWED_ORIGINS=

RELAY_WSS_URL=ws://localhost:8082/ws